# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# Check 'settings.py' for more information on the available settings and their default values.

# General
ENVIRONMENT=<your-environment>
LOGGER_NAME=<your-logger-name>

# Sentry
SENTRY_DSN=<your-sentry-dsn>

# GHCR
GHCR_USER=<your-github-username>
GHCR_PAT=<your-personal-access-token>

# Kaggle
# Get your token from https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=<your-kaggle-username>
KAGGLE_KEY=<your-kaggle-token>

# FastAPI
FASTAPI_HOST=<your-fastapi-host>
FASTAPI_PORT=<your-fastapi-port>
