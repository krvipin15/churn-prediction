# Development Environment Configuration Template
# Copy this file to .env.dev and fill in your actual values

# General
ENVIRONMENT=development
LOGGER_NAME=churn_forecast_dev

# GHCR
GHCR_USER=<your-github-username>
GHCR_PAT=<your-personal-access-token>

# Kaggle
KAGGLE_USERNAME=<your-kaggle-username>
KAGGLE_KEY=<your-kaggle-token>

# Dagshub
DAGSHUB_ACCESS_ID=<your-dagshub-id>

# FastAPI
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
