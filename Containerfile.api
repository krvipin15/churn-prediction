# Stage 1: Builder
FROM docker.io/library/python:3.12-slim AS builder

# Copy the uv binary from the official uv image
COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /uvx /bin/

WORKDIR /app

# Set environment variables for the build stage
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Install dependencies without installing the project itself
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --no-group docs

# Install the project into the virtual environment
COPY src ./src
COPY params.yaml README.md LICENSE ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-group docs

# Create the required directories and copy the necessary
RUN mkdir -p models
COPY models/preprocessor.joblib ./models/preprocessor.joblib
COPY models/model.ubj ./models/model.ubj
COPY models/card.json ./models/card.json

# Stage 2: Runtime
FROM docker.io/library/python:3.12-slim AS runtime

# Create app group/user and pre-allocate directories with correct permissions
RUN groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --create-home app \
    && mkdir -p /app/logs /app/data /app/reports \
    && chown -R app:app /app

WORKDIR /app

# Copy only the virtualenv and the application files
COPY --from=builder --chown=app:app /app /app

# Set runtime environment variables
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    PYTHONUNBUFFERED=1

# Enforce non-root execution context
USER 1000

EXPOSE 8000

# Run the application using uvicorn
CMD ["sh", "-c", "exec uvicorn churn_prediction.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
